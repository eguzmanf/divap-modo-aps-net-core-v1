@addTagHelper *, Vereyon.Web.FlashMessage
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DotacionWEBCore</title>
    <environment include="Development">
        <link href="~/lib/font-awesome-5-css/css/all.min.css" rel="stylesheet" />
        <link href="~/lib/bootstrap/dist/css/bootstrap-slate.css" rel="stylesheet" />
        <link href="~/lib/tempusdominus-bootstrap-4/build/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
        <link href="~/lib/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/site.css" />
        <link href="~/css/styles-horizontal-rules-hr.css" rel="stylesheet" />
    </environment>

    <environment include="Production">
        <link href="~/lib/font-awesome-5-css/css/all.min.css" rel="stylesheet" />
        <link href="~/lib/bootstrap/dist/css/bootstrap-slate.css" rel="stylesheet" />
        <link href="~/lib/tempusdominus-bootstrap-4/build/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
        <link href="~/lib/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/site.css" />
        <link href="~/css/styles-horizontal-rules-hr.css" rel="stylesheet" />
    </environment>


</head>
<body>
    <img src="~/minsal/Logos/Color_Minsal.png" />
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">

                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    <partial name="_LoginPartial" />
                    <ul class="navbar-nav flex-grow-1">
                        <li class="navbar-brand">
                            <a class="text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="navbar-brand">
                            <a class="text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Soporte</a>
                        </li>
                        <li class="navbar-brand">
                            <a class="text-dark" asp-area="" asp-controller="Home" asp-action="Readme">Manual</a>
                        </li>
                        @if (Context.Session.GetString("Role1") == "3" || ViewBag.RolId == "3")
                        {
                            <li class="navbar-brand">
                                <a class="text-dark" asp-area="" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>


    </header>
    <div class="container-fluid">
        <partial name="_CookieConsentPartial" />
        <div class="row">
            <section class="col-md-10 col-lg-10">
                <flash dismissable="true" />
                <article>
                    @RenderBody()
                </article>
            </section>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2019-2021 DotacionWEBCore - Version 2.2.4 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Soporte</a>
        </div>
    </footer>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery-3.6.0.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
        <script src="~/lib/moment.js/moment.min.js"></script>
        <script src="~/lib/moment.js/moment-with-locales.min.js"></script>
        <script src="~/lib/tempusdominus-bootstrap-4/build/js/tempusdominus-bootstrap-4.min.js"></script>
        <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
        <!-- Optional: include a polyfill for ES6 Promises for IE11 -->
        <script src="~/lib/promise-polyfill/polyfill.js"></script>

    </environment>

    <environment include="Production">
        <script src="~/lib/jquery/dist/jquery-3.6.0.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
        <script src="~/lib/moment.js/moment.min.js"></script>
        <script src="~/lib/moment.js/moment-with-locales.min.js"></script>
        <script src="~/lib/tempusdominus-bootstrap-4/build/js/tempusdominus-bootstrap-4.min.js"></script>
        <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
        <!-- Optional: include a polyfill for ES6 Promises for IE11 -->
        <script src="~/lib/promise-polyfill/polyfill.js"></script>
    </environment>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery.number.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
