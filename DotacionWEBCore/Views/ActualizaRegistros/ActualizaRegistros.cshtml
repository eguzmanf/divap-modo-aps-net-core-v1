                                <th id="Columna" name="Columna">Total Haberes (sueldo bruto)</th>
                                <th id="Columna" name="Columna">Validado</th>
                                <th id="Columna" name="Columna">Revisado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var registro in Model.Registros)
                            {
                                fila++;
                                <tr>
                                    <td align="center"><input type="checkbox" name="checkAll[]" class="checkSingle" value="@registro.ID" }></td>
                                    <td id="link" name="link">@Html.ActionLink("Editar", "EditaRegistros", "EditaRegistros", new { ID = @registro.ID }, null)</td>
                                    <td bgcolor="grey">@fila</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Servicio)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Comuna)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Establecimiento)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Administracion)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Rut)-@Html.DisplayFor(modelRegistro => registro.DV)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Nombre) @Html.DisplayFor(modelRegistro => registro.Apellido_Paterno) @Html.DisplayFor(modelRegistro => registro.Apellido_Materno)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Sexo)</td>
                                    <td>@Convert.ToDateTime(registro.Fecha_Nacimiento_Texto).ToString("dd/MM/yyyy")</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Nacionalidad)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Ley)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Tipo_contrato)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Categoria)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Nivel_Carrera)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Profesion)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Especialidad)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Cargo)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Funciones_Chofer)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Jornada)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Anos_Servicio)</td>
                                    <td>@Convert.ToDateTime(registro.Fecha_Ingreso_Texto).ToString("dd/MM/yyyy")</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Bienios)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Tipo_Prevision)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.Tipo_Isapre)</td>
                                    <td class="sBaseComunal">@Html.DisplayFor(modelRegistro => registro.SBase_Comunal)</td>
                                    <td class="haberes">@Html.DisplayFor(modelRegistro => registro.Haberes)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.ValidadoTexto)</td>
                                    <td>@Html.DisplayFor(modelRegistro => registro.RevisadoTexto)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @Html.PagedListPager(Model.Registros, page => Url.Action("ActualizaRegistros", new
                    {
                        Pagina = page,
                        TerminoBusqueda = Model.TerminoBusqueda
                    }),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new string[] { "page-item" },
                        PageClasses = new string[] { "page-link" }
                    })

                    <hr />
                    <div class="form-group">
                        <!-- Button trigger modal -->
                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal">
                            Validar Registros
                        </button>
                        <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">Validar Registros</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        Va a indicar que los registros seleccionados fueron validados por usted, esta acción no se puede deshacer ¿Indicar que los registros fueron validados?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                                        <button type="submit" class="btn btn-primary" asp-action="ActualizaRegistros">Si</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                }
                <br />
                <br />
                <hr />
                <div>
                    <a asp-controller="Home" asp-action="Index">Volver</a>
                </div>
                <hr />
            }
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("~/Views/ActualizaRegistros/js/_actualizaRegistrosJS.cshtml");}
}
