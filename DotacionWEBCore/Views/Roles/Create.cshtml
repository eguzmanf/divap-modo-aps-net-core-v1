@model DotacionWEBCore.Models.Role
@{
    ViewData["Title"] = "Crear Perfil";
}

<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-2">
            <!-- [##################################################################] -->
            <h3>@ViewData["Title"]</h3>
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Nombre" class="control-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-primary mr-2" type="submit">
                                <i class="fas fa-save"></i> Crear
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-undo"></i> Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }  <!-- archivo con js y jquery para validacion en carpeta View-> Share || Tambien al final del _Layout.cshtml está la linea que permite insertar estos codigos -->
}
