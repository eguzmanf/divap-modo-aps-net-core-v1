@model IEnumerable<DotacionWEBCore.Models.Role>
@{
    ViewData["Title"] = "Listado de Perfiles";
}

<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-2">
            <!-- [##################################################################] -->
            <h1>@ViewData["Title"]</h1>
            <p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Crear Nuevo Perfil
                </a>
            </p>
            <hr />
            <table class="table table-striped table-hover table-bordered">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Id)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <th class="text-center">@Html.DisplayFor(modelItem => role.Id)</th>
                            <th class="text-center">@Html.DisplayFor(modelItem => role.Nombre)</th>
                            <th class="text-center">
                                <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-secondary btn-sm">
                                    <i class="fas fa-pencil-alt"></i> Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-success btn-sm">
                                    <i class="fas fa-eye"></i> Detalle
                                </a>
                                <!--
                                <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash-alt"></i> Eliminar
                                </a>
                                -->
                            </th>
                        </tr>
                    }
                </tbody>
            </table>
            <p>
                <a asp-controller="Usuario" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-undo"></i> Regresar
                </a>
            </p>
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
