@model System.Data.DataTable
@using System.Data;
@using Microsoft.AspNetCore.Identity
@using DotacionWEBCore.Areas.Identity.Data
@inject SignInManager<DotacionWEBCoreUser> SignInManager
@inject UserManager<DotacionWEBCoreUser> UserManager

@{
    ViewData["Title"] = "Cargamultiple1";
}


<h1>Ingreso Dotación</h1>
<h4>Carga masiva de registro</h4>
<br />
<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-2">
            <!-- [##################################################################] -->
            @using (Html.BeginForm("upload", "Cargamultiple", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <a class="text-danger">  @Html.ValidationSummary() </a>

                <div class="form-group">
                    <label for="dataFile" class="btn btn-primary" data-toggle="modal" data-target="#exampleModalLoading" />
                    <i class="fas fa-cloud-upload-alt"></i> Seleccione Archivo
                    <input type="file" id="dataFile" name="upload" value="upload" onchange="this.form.submit()" style="display: none" />

                    <div class="modal fade" id="exampleModalLoading" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabelLoading" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">

                                <div class="modal-body">
                                    Cargando Excel...
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                if (Model != null)
                {
                    <h4 class="align-self-lg-center">Registros a cargar: </h4>
                    <br />
                    <table id="tablaregistros" name="tablaregistros" width="3700" class="table-active table-bordered">
                        <thead>
                            <tr>
                                @foreach (DataColumn col in Model.Columns)
                                {
                                    <th id="Columna" name="Columna">@col.ColumnName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    @foreach (DataColumn col in Model.Columns)
                                    {

                                        <td id="Fila" name="Fila">@row[col.ColumnName]</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }


            @using (Html.BeginForm("Registro", "InsertarDato", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {

                <hr />
                <!-- Button trigger modal -->
                <button type="button" id="InsertarDato" Name="InsertarDato" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal">
                    Guardar Registros
                </button>

                <!-- Modal -->
                if (Model != null)

                {
                    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">Guardar Registros</h5>
                                    <button id="InsertarDato" Name="InsertarDato" type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    Va a guardar los registros a la base de datos, esta acción no se puede deshacer ¿Guardar registros?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                                    <button type="submit" class="btn btn-primary">Si</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                {
                    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">Seleccione un archivo</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    Debe seleccionar un archivo con registros a cargar
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                }
            }
            <hr />
            <div>
                <a asp-controller="Home" asp-action="Index">Volver</a>
            </div>
            <hr />
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
