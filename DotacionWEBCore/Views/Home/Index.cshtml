            <div class="modal fade" id="ExampleModalLoading" tabindex="-1" role="dialog" aria-labelledby="ExampleModalLabelLoading" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Últimas Novedades</h5>
                        </div>
                        <div class="modal-body">
                            <label>@ViewData["Mensaje"]</label>
                        </div>
                        <div class="modal-footer">
                            <a href="#" data-dismiss="modal" class="btn btn-danger">Cerrar</a>



                        </div>
                    </div>
                </div>
            </div>




            <!-- Bootstrap core JavaScript -->
            <script src="~/vendor/jquery/jquery.min.js"></script>
