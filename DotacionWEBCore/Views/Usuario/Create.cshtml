@model DotacionWEBCore.ViewModels.UsuariosExtendidoViewModel
@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-2">
            <!-- [##################################################################] -->
            <h3>@ViewData["Title"]</h3>
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="Create" id="formCrearUsuario">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <!-- [ -- ########################################### [Extended] ########################################### -- ] -->
                        <div class="form-group">
                            <label asp-for="Extended.Nombres" class="control-label"></label>
                            <input id="nombresUsuario" asp-for="Extended.Nombres" class="form-control form-control-sm" autocomplete="off" placeholder="Ingrese sus Nombres…" maxlength="80" />
                            <span asp-validation-for="Extended.Nombres" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.ApellidoPaterno" class="control-label"></label>
                            <input id="apellidoPaternoUsuario" asp-for="Extended.ApellidoPaterno" class="form-control form-control-sm" autocomplete="off" placeholder="Ingrese su Apellido Paterno…" maxlength="80" />
                            <span asp-validation-for="Extended.ApellidoPaterno" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.ApellidoMaterno" class="control-label"></label>
                            <input id="apellidoMaternoUsuario" asp-for="Extended.ApellidoMaterno" class="form-control form-control-sm" autocomplete="off" placeholder="Ingrese su Apellido Materno…" maxlength="80" />
                            <span asp-validation-for="Extended.ApellidoMaterno" class="text-danger"></span>
                        </div>
                        <!--
                        <div class="form-group">
                            <label asp-for="Extended.FechaNacimiento" class="control-label"></label>
                            <div class="input-group date input-group-sm" id="fechaNacimientoUsuario" data-target-input="nearest">
                                <input type="text" asp-for="Extended.FechaNacimiento" id="fechaNacimientoUsuarioId" class="form-control form-control-sm datetimepicker-input" data-target="#fechaNacimientoUsuario" placeholder="@DateTime.Now.ToString("dd/MM/yyyy")" value=0 />
                                <div class="input-group-append" data-target="#fechaNacimientoUsuario" data-toggle="datetimepicker">
                                    <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                </div>
                            </div>
                            <span asp-validation-for="Extended.FechaNacimiento" class="text-danger"></span>
                        </div>
                        -->
                        <div class="form-group">
                            <label asp-for="Extended.FechaNacimiento" class="control-label"></label>
                            <input type="date" asp-for="Extended.FechaNacimiento" id="fechaNacimientoUsuarioId" class="form-control form-control-sm" />
                            <span asp-validation-for="Extended.FechaNacimiento" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.Genero" class="control-label"></label>
                            <select id="generoUsuario" asp-for="Extended.Genero" class="form-control form-control-sm" asp-items="Model.Extended.ListaSexo">
                                <option value="">---Seleccionar Género---</option>
                            </select>
                            <span asp-validation-for="Extended.Genero" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.NacionalidadId" class="control-label"></label>
                            <select id="nacionalidadUsuario" asp-for="Extended.NacionalidadId" class="form-control form-control-sm" asp-items="Model.Extended.ListaNacionalidad">
                                <option value="">---Seleccionar Nacionalidad---</option>
                            </select>
                            <span asp-validation-for="Extended.NacionalidadId" class="text-danger"></span>
                        </div>

                        <!-- [ -- ########################################### [Create] ########################################### -- ] -->
                        <div class="form-group">
                            <label asp-for="Create.UserName" class="control-label"></label>
                            <input id="userName" asp-for="Create.UserName" class="form-control form-control-sm" autocomplete="off" placeholder="12345678-9" maxlength="10" />
                            <span asp-validation-for="Create.UserName" class="text-danger"></span>
                            <div id="mensaje-error-rut-invalido" class="text-danger h6"></div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Create.Email" class="control-label"></label>
                            <input id="email" asp-for="Create.Email" class="form-control form-control-sm" autocomplete="off" placeholder="prefijo@dominio.cl" />
                            <span asp-validation-for="Create.Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Create.PhoneNumber" class="control-label"></label>
                            <input id="phone" asp-for="Create.PhoneNumber" class="form-control form-control-sm" autocomplete="off" placeholder="981423859 o 224767612" maxlength="9" />
                            <span asp-validation-for="Create.PhoneNumber" class="text-danger"></span>
                        </div>
                        <div id="mensaje-telefono-usuario-solo-numeros" class="text-danger" style="font-size:15px"></div>
                        <div class="form-group">
                            <label asp-for="Create.ID_Perfil" class="control-label"></label>
                            <select id="idPerfil" asp-for="Create.ID_Perfil" class="form-control form-control-sm" asp-items="Model.Create.Roles">
                                <option value="">---Seleccionar Perfil---</option>
                            </select>
                            <span asp-validation-for="Create.ID_Perfil" class="text-danger"></span>
                        </div>
                        <!-- ############################ Campos Ocultos ########################### -->
                        <div id="servicioComunaDiv">
                            <div class="form-group">
                                <label asp-for="Create.IdServicio" class="control-label"></label>
                                <select id="idServicio" asp-for="Create.IdServicio" class="form-control form-control-sm" asp-items="Model.Create.Servicios" disabled>
                                    <option value="">---Seleccionar Servicio---</option>
                                </select>
                                <span asp-validation-for="Create.IdServicio" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Create.ID_Comuna_U" class="control-label"></label>
                                <select id="idComuna" asp-for="Create.ID_Comuna_U" class="form-control form-control-sm" disabled>
                                    <option value="">---Seleccionar Comuna---</option>
                                </select>
                                <span asp-validation-for="Create.ID_Comuna_U" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- ##################################################################### -->
                        <div class="form-group">
                            <label asp-for="Create.PasswordHash"></label>
                            <div class="input-group input-group-sm">
                                <input id="passwordHash" type="password" asp-for="Create.PasswordHash" class="form-control form-control-sm" autocomplete="off" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fas fa-eye" id="togglePassword" style="cursor: pointer;"></i></span>
                                </div>
                            </div>
                            <span asp-validation-for="Create.PasswordHash" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Create.ConfirmPassword"></label>
                            <input type="password" asp-for="Create.ConfirmPassword" class="form-control form-control-sm" autocomplete="off" />
                            <span asp-validation-for="Create.ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-success mr-2" type="submit">
                                <i class="fas fa-save"></i> Crear
                            </button>
                            <a asp-action="Index" class="btn btn-info">
                                <i class="fas fa-undo"></i> Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("~/Views/Usuario/js/create/_createJs.cshtml");}
}
