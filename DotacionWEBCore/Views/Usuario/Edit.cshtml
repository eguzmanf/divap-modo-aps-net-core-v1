@model DotacionWEBCore.ViewModels.UsuariosExtendidoEditViewModel
@{
    ViewData["Title"] = "Editando al usuario con Nombre de Usuario " + Model.Edit.UserName + " (Rut)";
}

<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-2">
            <!-- [##################################################################] -->
            <h3>@ViewData["Title"]</h3>
            <!--<h4>@*@Model.Edit.Id*@</h4>-->
            <hr />
            <p>
                <!--
        <form asp-action="ChangePassword" method="GET">
            <input id="usserIdChangePassword" type="hidden" asp-for="Edit.Id" />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-key"></i> Cambiar Contraseña
            </button>
        </form>
        -->
                <a asp-controller="Usuario" asp-action="ChangePassword" asp-route-id="@Model.Edit.Id" class="btn btn-success">
                    <i class="fas fa-key"></i> Cambiar Contraseña
                </a>
            </p>
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="Edit" id="formEditarUsuario">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <!-- [ -- ########################################### [Extended] ########################################### -- ] -->
                        <input id="idUsuarioExtended" type="hidden" asp-for="Extended.Id" />
                        <div class="form-group">
                            <label asp-for="Extended.Nombres" class="control-label"></label>
                            <input id="nombresUsuario" asp-for="Extended.Nombres" class="form-control form-control-sm" autocomplete="off" placeholder="Ingrese sus Nombres…" maxlength="80" />
                            <span asp-validation-for="Extended.Nombres" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.ApellidoPaterno" class="control-label"></label>
                            <input id="apellidoPaternoUsuario" asp-for="Extended.ApellidoPaterno" class="form-control form-control-sm" autocomplete="off" placeholder="Ingrese su Apellido Paterno…" maxlength="80" />
                            <span asp-validation-for="Extended.ApellidoPaterno" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.ApellidoMaterno" class="control-label"></label>
                            <input id="apellidoMaternoUsuario" asp-for="Extended.ApellidoMaterno" class="form-control form-control-sm" autocomplete="off" placeholder="Ingrese su Apellido Materno…" maxlength="80" />
                            <span asp-validation-for="Extended.ApellidoMaterno" class="text-danger"></span>
                        </div>
                        <!--
                        <div class="form-group">
                            <label asp-for="Extended.FechaNacimiento" class="control-label"></label>
                            <div class="input-group date input-group-sm" id="fechaNacimientoUsuario" data-target-input="nearest">
                                <input type="text" asp-for="Extended.FechaNacimiento" id="fechaNacimientoUsuarioId" class="form-control form-control-sm datetimepicker-input" data-target="#fechaNacimientoUsuario" placeholder="@DateTime.Now.ToString("dd/MM/yyyy")" />
                                <div class="input-group-append" data-target="#fechaNacimientoUsuario" data-toggle="datetimepicker">
                                    <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                </div>
                            </div>
                            <span asp-validation-for="Extended.FechaNacimiento" class="text-danger"></span>
                        </div>
                        -->
                        <div class="form-group">
                            <label asp-for="Extended.FechaNacimiento" class="control-label"></label>
                            <input type="date" asp-for="Extended.FechaNacimiento" id="fechaNacimientoUsuarioId" class="form-control form-control-sm" />
                            <span asp-validation-for="Extended.FechaNacimiento" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.Genero" class="control-label"></label>
                            <select id="generoUsuario" asp-for="Extended.Genero" class="form-control form-control-sm" asp-items="Model.Extended.ListaSexo">
                                <option value="">---Seleccionar Género---</option>
                            </select>
                            <span asp-validation-for="Extended.Genero" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Extended.NacionalidadId" class="control-label"></label>
                            <select id="nacionalidadUsuario" asp-for="Extended.NacionalidadId" class="form-control form-control-sm" asp-items="Model.Extended.ListaNacionalidad">
                                <option value="">---Seleccionar Nacionalidad---</option>
                            </select>
                            <span asp-validation-for="Extended.NacionalidadId" class="text-danger"></span>
                        </div>
                        <!-- [ -- ########################################### [Edit] ########################################### -- ] -->
                        <input id="idUsuario" type="hidden" asp-for="Edit.Id" />
                        <div class="form-group">
                            <label asp-for="Edit.UserName" class="control-label"></label>
                            <input id="userName" asp-for="Edit.UserName" class="form-control form-control-sm" autocomplete="off" placeholder="12345678-9" maxlength="10" readonly />
                            <span asp-validation-for="Edit.UserName" class="text-danger"></span>
                            <div id="mensaje-error-rut-invalido" class="text-danger"></div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Edit.Email" class="control-label"></label>
                            <input id="email" asp-for="Edit.Email" class="form-control form-control-sm" autocomplete="off" placeholder="prefijo@dominio.cl" />
                            <span asp-validation-for="Edit.Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Edit.PhoneNumber" class="control-label"></label>
                            <input id="phone" asp-for="Edit.PhoneNumber" class="form-control form-control-sm" autocomplete="off" placeholder="981423859 o 224767612" maxlength="9" />
                            <span asp-validation-for="Edit.PhoneNumber" class="text-danger"></span>
                        </div>
                        <div id="mensaje-telefono-usuario-solo-numeros" class="text-danger" style="font-size:15px"></div>
                        <div class="form-group">
                            <label asp-for="Edit.ID_Perfil" class="control-label"></label>
                            <select id="idPerfil" asp-for="Edit.ID_Perfil" class="form-control form-control-sm" asp-items="Model.Edit.Roles">
                                <option value="">---Seleccionar Perfil---</option>
                            </select>
                            <span asp-validation-for="Edit.ID_Perfil" class="text-danger"></span>
                        </div>
                        <!-- ############################ Campos Ocultos ########################### -->
                        <div id="servicioComunaDiv">
                            <div class="form-group">
                                <label asp-for="Edit.IdServicio" class="control-label"></label>
                                <select id="idServicio" asp-for="Edit.IdServicio" class="form-control form-control-sm" asp-items="Model.Edit.Servicios">
                                    <option value="">---Seleccionar Servicio---</option>
                                </select>
                                <span asp-validation-for="Edit.IdServicio" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Edit.ID_Comuna_U" class="control-label"></label>
                                <select id="idComuna" asp-for="Edit.ID_Comuna_U" class="form-control form-control-sm">
                                    <option value="">---Seleccionar Comuna---</option>
                                </select>
                                <span asp-validation-for="Edit.ID_Comuna_U" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- ##################################################################### -->
                        <div class="form-group">
                            <label asp-for="Edit.LockoutEnabled" class="control-label"></label>
                            <div class="custom-control custom-switch">
                                <input id="habilitado" type="checkbox" asp-for="Edit.LockoutEnabled" class="custom-control-input">
                                <label class="custom-control-label" for="habilitado"><span id="badge-lockout-enabled" style="font-size:18px" class="badge badge-pill badge-success"></span></label>
                            </div>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-primary mr-2" type="submit">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-info">
                                <i class="fas fa-undo"></i> Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("~/Views/Usuario/js/edit/_editJs.cshtml");}
}
