@model DotacionWEBCore.ViewModels.UsuarioChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-2">
            <!-- [##################################################################] -->
            <h3>@ViewData["Title"]</h3>
            <!--<h4>@*@Model.Id*@</h4>-->
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="ChangePassword">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <label asp-for="PasswordHash"></label>
                            <div class="input-group">
                                <input id="passwordHash" type="password" asp-for="PasswordHash" class="form-control" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fas fa-eye" id="togglePassword" style="cursor: pointer;"></i></span>
                                </div>
                            </div>
                            <span asp-validation-for="PasswordHash" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfirmPassword"></label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-primary mr-2" type="submit">
                                <i class="fas fa-key"></i> Cambiar Contraseña
                            </button>
                            <a asp-action="Index" class="btn btn-info">
                                <i class="fas fa-undo"></i> Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("~/Views/Usuario/js/change-password/_change-password.cshtml");}
}
