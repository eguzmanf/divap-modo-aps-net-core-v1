@page
@model LoginModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration configuration

@{
    ViewData["Title"] = "Ingreso";
}

<div class="tab-pane fade show" role="tabpanel">
    <div class="row justify-content-center">
        <div class="col-sm-11 offset-sm-10">
            <h1>@ViewData["Title"]</h1>
            <div class="row">
                <div class="col-md-4">
                    <section>
                        <form id="account" method="post">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="Input.UserName"></label>
                                <input asp-for="Input.UserName" class="form-control" />
                                <span asp-validation-for="Input.UserName" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.Password"></label>
                                <input asp-for="Input.Password" class="form-control" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <div class="checkbox">
                                    <label asp-for="Input.RememberMe">
                                        <input asp-for="Input.RememberMe" />
                                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="g-recaptcha" data-theme="dark" data-sitekey="@(configuration.GetValue<String>("GoogleReCaptcha:Key"))"></div>
                                <script src="https://www.google.com/recaptcha/api.js" async defer></script>
                                <br />
                                <button type="submit" class="btn btn-primary">Ingresar</button>
                            </div>
                        </form>
                    </section>
                </div>
            </div>
            <!-- [##################################################################] -->
        </div>
    </div>
</div>
@section Scripts {


    <partial name="_ValidationScriptsPartial" />
}
